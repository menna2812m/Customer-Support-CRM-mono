{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Crm": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "AutoMigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "Staff": {
      "Enabled": false
    },
    "Portal": {
      "Enabled": false
    }
  },
  "Observability": {
    "LogFilePath": "D:/CrmLogs/crm-.log",
    "RetainedFileCount": 30,
    "CorrelationHeader": "X-Correlation-Id"
  }
}
