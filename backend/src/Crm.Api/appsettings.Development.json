{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Database": {
    "AutoMigrateOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Authentication": {
    "Staff": {
      "Enabled": false,
      "Authority": "http://localhost:8080/realms/crm",
      "ClientId": "crm-api"
    }
  },
  "Identity": {
    "DefaultRole": "Agent"
  },
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "auth-sign-in": {
        "PermitLimit": 100,
        "WindowSeconds": 60
      },
      "auth-session": {
        "PermitLimit": 300,
        "WindowSeconds": 60
      }
    }
  }
}
